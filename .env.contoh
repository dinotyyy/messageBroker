# Salin file ini menjadi .env sebelum menjalankan apa pun:
#   cp .env.contoh .env
#
# Port berbeda dari simpel-lab (5672/15672/5432) secara sengaja, supaya proyek
# ini bisa dijalankan berdampingan dengan simpel-lab tanpa bentrok port kalau
# keduanya kebetulan menyala bersamaan. Container dan volume juga bernama beda
# (a04-*), sepenuhnya independen dari data lab.

# --- RabbitMQ -----------------------------------------------------------
RABBITMQ_USER=a04
RABBITMQ_PASS=a04pengolahan
RABBITMQ_VHOST=/
RABBITMQ_PORT=5682
RABBITMQ_UI_PORT=15682

AMQP_URL=amqp://a04:a04pengolahan@localhost:5682
RABBITMQ_MGMT_URL=http://127.0.0.1:15682

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=a04
POSTGRES_PASSWORD=a04pengolahan
POSTGRES_DB=a04
POSTGRES_PORT=5442

DATABASE_URL=postgres://a04:a04pengolahan@localhost:5442/a04

# --- Simulasi kerja worker (opsional, boleh dibiarkan default) ------------
A04_KERJA_MIN_MS=40
A04_KERJA_MAX_MS=160
